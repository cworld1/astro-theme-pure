          { type: 'site', href: 'https://status.pipitonelabs.com/' },
          { type: 'doc', href: 'https://github.com/pipitonelabs/k8s-gitops/blob/main/README.md' },
          { type: 'release', href: 'https://www.npmjs.com/package/astro-pure' }
